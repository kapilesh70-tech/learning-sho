# ── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ── MongoDB (optional — the API runs without it) ────────────────
# MONGO_URI=mongodb://localhost:27017/kapilesh-learning
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/kapilesh-learning

# ── Email notification (optional — placeholders, do not commit real values)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=
